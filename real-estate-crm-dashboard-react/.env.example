# Copy to `.env.local` in this folder (never commit `.env.local`).
# Rotate any token that was ever pasted into chat or committed.

GHL_API_TOKEN=
GHL_LOCATION_ID=

# Optional override:
# GHL_BASE_URL=https://services.leadconnectorhq.com

# Call-notes sync (Jared's Weekly To-Do's sheet → GHL contact notes)
# Sheet: https://docs.google.com/spreadsheets/d/1mYQW-dViPp-E0j62aaFqmVPAM_Mgd7_W
CALL_NOTES_SHEET_ID=1mYQW-dViPp-E0j62aaFqmVPAM_Mgd7_W
# Service account JSON key (as a single-line JSON string), shared as a Viewer on the sheet:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"..."}'

# ClickUp — sync tasks from space "Transactions - Sales & Purchases"
# (same token works as CLICKUP_API_KEY if you prefer)
# CLICKUP_API_TOKEN=pk_...
# CLICKUP_SPACE_ID=
# Legacy (only if lists hang under a folder, not the space root):
# CLICKUP_FOLDER_ID=
